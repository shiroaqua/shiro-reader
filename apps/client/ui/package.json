{
  "name": "shiro-reader-client-ui",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:desktop",
    "dev:desktop": "pnpm --filter @shiro/desktop-ui dev",
    "dev:desktop:mock": "pnpm --filter @shiro/desktop-ui dev:mock",
    "dev:mobile": "pnpm --filter @shiro/mobile-ui dev",
    "dev:mobile:mock": "pnpm --filter @shiro/mobile-ui dev:mock",
    "build": "pnpm --filter @shiro/desktop-ui build && pnpm --filter @shiro/mobile-ui build",
    "build:desktop": "pnpm --filter @shiro/desktop-ui build",
    "build:mobile": "pnpm --filter @shiro/mobile-ui build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -p packages/shared/tsconfig.json --noEmit && tsc -p packages/desktop/tsconfig.json --noEmit && tsc -p packages/desktop/tsconfig.node.json --noEmit && tsc -p packages/mobile/tsconfig.json --noEmit && tsc -p packages/mobile/tsconfig.node.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "node -e \"import('node:child_process').then(({spawnSync})=>{process.exit(spawnSync(process.execPath,['./ui/node_modules/@tauri-apps/cli/tauri.js',...process.argv.slice(1)],{cwd:'..',stdio:'inherit'}).status??1)})\" --"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@shiro/desktop-ui": "workspace:*",
    "@shiro/mobile-ui": "workspace:*",
    "@shiro/ui-shared": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.104.1",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "jsdom": "^31.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.1.1"
  }
}
