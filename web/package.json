    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "test:all": "bash scripts/test-all.sh",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
