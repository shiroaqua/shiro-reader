{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShiroReader",
  "version": "0.0.1",
  "identifier": "com.shiroaqua.shiroreader",
  "build": {
    "beforeDevCommand": "pnpm --dir ../ui dev:desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../ui build:desktop",
    "frontendDist": "../ui/packages/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShiroReader",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://shiro-cover.localhost shiro-cover:; img-src 'self' asset: http://asset.localhost http://shiro-cover.localhost shiro-cover: blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
